CREATE TABLE tarifasKm (
  idTarifa INT AUTO_INCREMENT PRIMARY KEY,
  Km INT NOT NULL,
  PrecioXKm DECIMAL(12,2) NOT NULL,
  VigenteDesde DATE NOT NULL,
  IsActive TINYINT DEFAULT 1,
  idUsuarioCreador INT NOT NULL,
  FechaRegistro DATETIME DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;


CREATE TABLE movFinancieros (
  idMovFinanciero INT AUTO_INCREMENT PRIMARY KEY,
  TipoMov ENUM('Pago','Cobro','Gasto'),
  MedioPago ENUM('Efectivo','Transferencia','Cheque','Tarjeta') NOT NULL DEFAULT 'Efectivo',
  MontoMov DECIMAL(10,2),
  FechaRegistro DATETIME DEFAULT CURRENT_TIMESTAMP,
  FechaMov DATETIME,
  EstadoMov ENUM('Pendiente','Cancelado','Cerrado'),
  Descripcion TEXT,
  IdPersona INT NOT NULL,
  IdCaja INT NOT NULL,
  IdOperacion INT NOT NULL,
  IdMovCompra INT NULL,
  IdMovVenta INT NULL,
  IdMovTransporte INT NULL,
  idUsuario INT NOT NULL,
  CONSTRAINT fk_movf_persona
    FOREIGN KEY (IdPersona) REFERENCES personas(idPersona)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  CONSTRAINT fk_movf_caja
    FOREIGN KEY (IdCaja) REFERENCES cajas(idCaja)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  CONSTRAINT fk_movf_operacion
    FOREIGN KEY (IdOperacion) REFERENCES operaciones(idOperacion)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  CONSTRAINT fk_movf_movc
    FOREIGN KEY (IdMovCompra) REFERENCES movCompras(idMovCompra)
    ON UPDATE CASCADE
    ON DELETE SET NULL,
  CONSTRAINT fk_movf_movv
    FOREIGN KEY (IdMovVenta) REFERENCES movVentas(idMovVenta)
    ON UPDATE CASCADE
    ON DELETE SET NULL,
  CONSTRAINT fk_movf_movt
    FOREIGN KEY (IdMovTransporte) REFERENCES movTransportes(idMovTransporte)
    ON UPDATE CASCADE
    ON DELETE SET NULL,
  CONSTRAINT fk_movf_usuario
    FOREIGN KEY (idUsuario) REFERENCES usuarios(idUsuario)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  INDEX idx_movf_IdOperacion (IdOperacion),
  INDEX idx_movf_IdPersona (IdPersona),
  INDEX idx_movf_idUsuario (idUsuario)
) ENGINE=InnoDB;

CREATE TABLE cheques (
  idCheque INT AUTO_INCREMENT PRIMARY KEY,
  NumeroCheque VARCHAR(50) NOT NULL,
  Banco VARCHAR(100),
  Importe DECIMAL(10,2) NOT NULL,
  FechaRegistro DATETIME DEFAULT CURRENT_TIMESTAMP,
  FechaEmision DATETIME NOT NULL,
  FechaVencimiento DATETIME NOT NULL,
  FechaPago DATETIME NULL,
  EstadoCheque ENUM('Pendiente','Depositado','Rechazado','Pagado') DEFAULT 'Pendiente',
  Descripcion TEXT,
  IdMovFinanciero INT NOT NULL,
  CONSTRAINT fk_cheques_movf
    FOREIGN KEY (IdMovFinanciero) REFERENCES movFinancieros(idMovFinanciero)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  INDEX idx_cheques_IdMovFinanciero (IdMovFinanciero)
) ENGINE=InnoDB;

CREATE TABLE auditoriaCambios (
  idAuditoriaCambio INT AUTO_INCREMENT PRIMARY KEY,
  FechaRegistro DATETIME DEFAULT CURRENT_TIMESTAMP,
  Accion ENUM('Insertar','Modificar','Eliminar'),
  TablaAfectada VARCHAR(50),
  IdRegistro INT,
  idUsuario INT NOT NULL,
  ValorAnterior TEXT,
  ValorNuevo TEXT,
  Descripcion TEXT,
  CONSTRAINT fk_audit_usuario
    FOREIGN KEY (idUsuario) REFERENCES usuarios(idUsuario)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  INDEX idx_audit_TablaId (TablaAfectada, IdRegistro),
  INDEX idx_audit_idUsuario (idUsuario)
) ENGINE=InnoDB;